{
  "schema_version": 1,
  "jobs": [
    {
      "id": "niulai.daily-business.v1",
      "enabled": false,
      "schedule": {"kind": "daily", "timezone": "America/New_York", "times": ["13:00", "19:00"], "grace_seconds": 3600},
      "replay_safe": true,
      "model_profile": "niulai-business-test",
      "prompt_file": "niulai-runtime/jobs/daily-business-prompt.md",
      "adapter": "niulai_runtime.daily_job:prepare",
      "completion_adapter": "niulai_runtime.daily_job:verify",
      "adapter_config": {
        "policy": ".niulai-state/config/daily.json",
        "source_directory": ".niulai-state/daily-inputs/current",
        "authorization": ".niulai-state/config/parallel-authorization.json",
        "target": "schedule"
      }
    },
    {
      "id": "niulai.daily-data-recovery.v1",
      "enabled": false,
      "schedule": {"kind": "interval", "seconds": 300, "grace_seconds": 300},
      "replay_safe": true,
      "model_profile": "niulai-business-test",
      "prompt_file": "niulai-runtime/jobs/daily-business-prompt.md",
      "adapter": "niulai_runtime.daily_job:prepare",
      "completion_adapter": "niulai_runtime.daily_job:verify",
      "adapter_config": {
        "policy": ".niulai-state/config/daily.json",
        "authorization": ".niulai-state/config/parallel-authorization.json",
        "target": "recovery"
      }
    }
  ]
}
