{
  "$id": "urn:trading-agent:live-provider-readiness-case-packet-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_packet": {
      "const": {
        "case": {
          "alternate_html_url": "https://newsroom.servicenow.com/press-releases/details/2025/ServiceNow-Reports-First-Quarter-2025-Financial-Results/default.aspx",
          "canonical_disclosure_id": "servicenow-q1-2025-financial-results",
          "case_id": "now-q1-2025-financial-results-positive-control-v1",
          "issuer_id": "NOW",
          "primary_pdf_url": "https://s205.q4cdn.com/537566246/files/doc_news/ServiceNow-Reports-First-Quarter-2025-Financial-Results-2025.pdf",
          "question": "What does the official Q1 2025 release establish, and what remains unestablished?",
          "quote_preselected": false,
          "search_query": "site:newsroom.servicenow.com \"ServiceNow Reports First Quarter 2025 Financial Results\"",
          "selection_bias": "NOW is repeatedly inspected development evidence and may only be a positive control."
        },
        "equivalence_review": {
          "caveat": "Q4 CDN is the hosting intermediary; approval establishes publisher-authorized representation, not byte identity or complete textual parity.",
          "disclosure_date_match": true,
          "publisher_control": true,
          "rationale": "The ServiceNow Newsroom HTML page explicitly labels and links the 244 KB PDF as the PDF-format download of the same titled and dated release.",
          "release_identity_match": true,
          "representation_relationship": true,
          "reviewer_id": "independent-live-browser-review",
          "status": "approved",
          "title_match": true
        },
        "question_contract": {
          "capability_ids": [
            "web_search",
            "official_document"
          ],
          "depends_on": [],
          "evidence_to_seek": "One literal source-grounded observation from the sealed disclosure.",
          "facet": "current_disclosure",
          "id": "now-q1-2025:issuer",
          "priority": "required",
          "source_roles": [
            "issuer_document"
          ],
          "stop_rule": "Stop after one reviewed candidate support unit or an explicit terminal gap."
        },
        "schema_version": "live-provider-case-packet-1",
        "source_contract": {
          "eligible_body_rules": [
            "exact_url_match",
            "screened_before_exposure",
            "literal_quote_selected_only_after_screening"
          ],
          "eligible_pdf_failure_codes": [
            "HOST_WEB_BODY_TOO_LARGE",
            "HOST_WEB_SOURCE_INACCESSIBLE"
          ],
          "evidence_facet": "current issuer disclosure",
          "required_access_level": "document",
          "required_capability": "official_document",
          "source_role": "issuer_document",
          "unparseable_predeclared": false
        },
        "url_policy": {
          "allowed_hosts": [
            "newsroom.servicenow.com",
            "s205.q4cdn.com"
          ],
          "normalization": "exact_https_url_bytes",
          "redirects": "reject_unless_frozen_target_matches"
        }
      }
    },
    "seal": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "case_packet_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "case_packet_sha256"
      ],
      "type": "object"
    }
  },
  "required": [
    "case_packet",
    "seal"
  ],
  "type": "object"
}
