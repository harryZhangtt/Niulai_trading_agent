    "formula_constants": {
      "return_windows_sessions": [
        21,
        63,
        126
      ],
      "annualization_sessions": 252,
      "high_window_sessions": 126,
      "realized_volatility_window_sessions": 21,
      "downside_semivariance_window_sessions": 63,
      "benchmark_gap_window_sessions": 21,
      "benchmark_compounding_multiple": 3
    },
    "formula_definitions": {
      "simple_return": "price_t / price_t_minus_window - 1",
      "realized_volatility": "sqrt(252 * mean((log_return - mean_log_return)^2))",
      "distance_from_126_high": "price_t / max(price_t_minus_125_through_t) - 1",
      "downside_semivariance": "252 * mean(min(log_return, 0)^2)",
      "soxl_vs_3x_soxx_gap_21": "soxl_return_21 - ((1 + soxx_return_21)^3 - 1)"
    },
