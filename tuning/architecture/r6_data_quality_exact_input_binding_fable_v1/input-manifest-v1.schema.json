{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "r6-data-quality-exact-input-manifest-v1.schema.json",
  "title": "R6 four-cell exact current input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "current_as_of", "authority", "common_binding", "cell_bindings", "semantic_audit", "unresolved_pins", "dependencies", "countable", "effects"],
  "properties": {
    "version": {"const": "r6-data-quality-exact-input-manifest-v1"},
    "status": {"const": "CURRENT_REHASHED_PROVIDER_FREE_NONCOUNTABLE"},
    "current_as_of": {"const": "2026-11-11"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_root", "source_kind", "rehash_required", "stale_snapshot_excluded"],
      "properties": {
        "source_root": {"const": "mentor/runtime/scheduler-midresponse-recovery-20261107"},
        "source_kind": {"const": "REHASHED_CURRENT_WORKSPACE_BYTES"},
        "rehash_required": {"const": true},
        "stale_snapshot_excluded": {"const": "runtime/data-quality-r6-window-20261111-v1/snapshot-and-first-evidence.json"}
      }
    },
    "common_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_utf8_bytes", "canonical_sha256", "artifacts"],
      "properties": {
        "canonical_utf8_bytes": {"const": 661},
        "canonical_sha256": {"const": "256084e6362d87549392d3b069ce77edb1b8197d58b4d4b9045bbd5eaaa63426"},
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["payload", "source_cutoff", "rubric", "thresholds", "evaluation_schema"],
          "properties": {
            "payload": {"$ref": "#/$defs/payloadRef"},
            "source_cutoff": {"$ref": "#/$defs/cutoffRef"},
            "rubric": {"$ref": "#/$defs/artifactRef"},
            "thresholds": {"$ref": "#/$defs/artifactRef"},
            "evaluation_schema": {"$ref": "#/$defs/artifactRef"}
          }
        }
      }
    },
    "cell_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["R6DQ-7F2C91A4", "R6DQ-1B8E43D7", "R6DQ-C4A7095E", "R6DQ-92D6F0B3"],
      "properties": {
        "R6DQ-7F2C91A4": {"$ref": "#/$defs/cellBinding"},
        "R6DQ-1B8E43D7": {"$ref": "#/$defs/cellBinding"},
        "R6DQ-C4A7095E": {"$ref": "#/$defs/cellBinding"},
        "R6DQ-92D6F0B3": {"$ref": "#/$defs/cellBinding"}
      }
    },
    "semantic_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_case_suitable", "official_sources_only", "cutoff_exact", "no_identity_treatment_or_order_leakage", "no_private_or_internal_source_dependency", "rubric_measures_data_quality", "thresholds_measure_data_quality", "no_financial_return_metric", "no_specific_provider_preference"],
      "properties": {
        "research_case_suitable": {"const": true},
        "official_sources_only": {"const": true},
        "cutoff_exact": {"const": true},
        "no_identity_treatment_or_order_leakage": {"const": true},
        "no_private_or_internal_source_dependency": {"const": true},
        "rubric_measures_data_quality": {"const": true},
        "thresholds_measure_data_quality": {"const": true},
        "no_financial_return_metric": {"const": true},
        "no_specific_provider_preference": {"const": true}
      }
    },
    "unresolved_pins": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/pendingPin"}
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "account", "private_state", "bytedcli", "external_python_packages"],
      "properties": {
        "network": {"const": false},
        "account": {"const": false},
        "private_state": {"const": false},
        "bytedcli": {"const": false},
        "external_python_packages": {"const": false}
      }
    },
    "countable": {"const": false},
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "network", "account", "private_state", "email", "business", "host", "scheduler"],
      "properties": {
        "provider": {"const": false},
        "network": {"const": false},
        "account": {"const": false},
        "private_state": {"const": false},
        "email": {"const": false},
        "business": {"const": false},
        "host": {"const": false},
        "scheduler": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "payloadRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "prompt_utf8_bytes", "prompt_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"const": 2065},
        "sha256": {"const": "26d9a937f50dc22dade3251831e7860b4a7188c3001d5717ed4aac4d4ccac01a"},
        "prompt_utf8_bytes": {"const": 526},
        "prompt_sha256": {"const": "3c75beab1bca33029e8de266e36468543d5d3ef2910916d66cc7c4d9bbc0df6b"}
      }
    },
    "cutoffRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "cutoff_at"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"const": 1044},
        "sha256": {"const": "32f28a6cea0b1053321a52782abe40d6fd8a2d58b95bb954f90794ec5b733072"},
        "cutoff_at": {"const": "2026-11-09T00:00:00Z"}
      }
    },
    "cellBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common_input_canonical_sha256", "payload_artifact_sha256", "prompt_utf8_bytes", "prompt_sha256", "source_cutoff_sha256", "cutoff_at"],
      "properties": {
        "common_input_canonical_sha256": {"const": "256084e6362d87549392d3b069ce77edb1b8197d58b4d4b9045bbd5eaaa63426"},
        "payload_artifact_sha256": {"const": "26d9a937f50dc22dade3251831e7860b4a7188c3001d5717ed4aac4d4ccac01a"},
        "prompt_utf8_bytes": {"const": 526},
        "prompt_sha256": {"const": "3c75beab1bca33029e8de266e36468543d5d3ef2910916d66cc7c4d9bbc0df6b"},
        "source_cutoff_sha256": {"const": "32f28a6cea0b1053321a52782abe40d6fd8a2d58b95bb954f90794ec5b733072"},
        "cutoff_at": {"const": "2026-11-09T00:00:00Z"}
      }
    },
    "pendingPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pin", "status", "required_before"],
      "properties": {
        "pin": {"enum": ["tool_roster", "time_window", "final_grants"]},
        "status": {"const": "PENDING_NOT_AUTHORIZED_OR_SEALED"},
        "required_before": {"const": "ANY_LIVE_OR_COUNTABLE_CELL"}
      }
    }
  }
}
