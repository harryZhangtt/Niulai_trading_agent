{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"factor-fresh-split-readiness-v1",
  "$defs":{
    "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "optionalSha":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha"}]},
    "date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "parameters":{"type":"object","additionalProperties":false,"required":["horizon_sessions","purge_sessions","embargo_sessions","validation_origins","protected_origins","monthly_origin_rule"],"properties":{"horizon_sessions":{"type":"integer","minimum":1},"purge_sessions":{"type":"integer","minimum":1},"embargo_sessions":{"type":"integer","minimum":0},"validation_origins":{"type":"integer","minimum":1},"protected_origins":{"type":"integer","minimum":1},"monthly_origin_rule":{"const":"last-session-of-month"}}},
    "candidate":{"type":"object","additionalProperties":false,"required":["schema_version","status","authoritative","sealable","t_seen","as_of_session","calendar_sha256","parameters","validation_deficit","protected_deficit","validation","protected","split_identities"],"properties":{"schema_version":{"const":1},"status":{"enum":["ready","inconclusive_awaiting_fresh_data"]},"authoritative":{"const":false},"sealable":{"const":false},"t_seen":{"$ref":"#/$defs/date"},"as_of_session":{"$ref":"#/$defs/date"},"calendar_sha256":{"$ref":"#/$defs/sha"},"parameters":{"$ref":"#/$defs/parameters"},"validation_deficit":{"type":"integer","minimum":0},"protected_deficit":{"type":"integer","minimum":0},"validation":{"type":"array","items":{"$ref":"#/$defs/date"}},"protected":{"type":"array","items":{"$ref":"#/$defs/date"}},"split_identities":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["validation","protected"],"properties":{"validation":{"$ref":"#/$defs/sha"},"protected":{"$ref":"#/$defs/sha"}}}]}}}
  },
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","kind","status","authoritative","sealable","blockers","ledger_binding","identity_bindings","candidate_plan","candidate_plan_sha256","integration_identity_sha256"],
  "properties":{
    "schema_version":{"const":1},
    "kind":{"const":"factor_fresh_split_readiness"},
    "status":{"const":"blocked_nonsealable"},
    "authoritative":{"const":false},
    "sealable":{"const":false},
    "blockers":{"type":"array","minItems":1,"items":{"type":"string"}},
    "ledger_binding":{"type":"object","additionalProperties":false,"required":["ledger_id","ledger_genesis_sha256","sequence","last_event_sha256","t_seen"],"properties":{"ledger_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_.-]{0,95}$"},"ledger_genesis_sha256":{"$ref":"#/$defs/sha"},"sequence":{"type":"integer","minimum":0},"last_event_sha256":{"$ref":"#/$defs/optionalSha"},"t_seen":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/date"}]}}},
    "identity_bindings":{"type":"object","additionalProperties":false,"required":["authority_deployment_profile_sha256","admission_policy_sha256","source_inventory_sha256","dataset_snapshot_sha256","observation_set_sha256","feature_snapshot_sha256","evaluation_population_sha256","calendar_identity_sha256","universe_identity_sha256","label_roster_sha256"],"properties":{"authority_deployment_profile_sha256":{"$ref":"#/$defs/sha"},"admission_policy_sha256":{"$ref":"#/$defs/sha"},"source_inventory_sha256":{"$ref":"#/$defs/sha"},"dataset_snapshot_sha256":{"$ref":"#/$defs/optionalSha"},"observation_set_sha256":{"$ref":"#/$defs/optionalSha"},"feature_snapshot_sha256":{"$ref":"#/$defs/optionalSha"},"evaluation_population_sha256":{"$ref":"#/$defs/optionalSha"},"calendar_identity_sha256":{"$ref":"#/$defs/sha"},"universe_identity_sha256":{"$ref":"#/$defs/sha"},"label_roster_sha256":{"$ref":"#/$defs/sha"}}},
    "candidate_plan":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/candidate"}]},
    "candidate_plan_sha256":{"$ref":"#/$defs/optionalSha"},
    "integration_identity_sha256":{"$ref":"#/$defs/sha"}
  }
}
