{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","kind","manifest_sha256","checkpoint_sha256","aggregate_schema_id","aggregate_schema_version","evaluator_receipt_sha256","checker_attestation_sha256","key_status_sha256","issued_at","trust_class","signer_key_version","signer_public_key_sha256","signature_encoding","signature"],"properties":{"schema_version":{"const":1},"kind":{"const":"gcp_independent_checker_receipt"},"manifest_sha256":{"$ref":"#/$defs/sha"},"checkpoint_sha256":{"$ref":"#/$defs/sha"},"aggregate_schema_id":{"$ref":"#/$defs/id"},"aggregate_schema_version":{"type":"integer","minimum":1},"evaluator_receipt_sha256":{"$ref":"#/$defs/sha"},"checker_attestation_sha256":{"$ref":"#/$defs/sha"},"key_status_sha256":{"$ref":"#/$defs/sha"},"issued_at":{"$ref":"#/$defs/time"},"trust_class":{"enum":["production","synthetic_fixture"]},"signer_key_version":{"$ref":"#/$defs/resource"},"signer_public_key_sha256":{"$ref":"#/$defs/sha"},"signature_encoding":{"enum":["ECDSA_DER_BASE64","FIXTURE_HMAC_SHA256_HEX"]},"signature":{"type":"string","minLength":1,"maxLength":4096}},"$defs":{"sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,62}$"},"time":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},"resource":{"type":"string","pattern":"^projects/[a-z][a-z0-9-]{4,28}/locations/[a-z0-9-]+/[A-Za-z0-9_./-]+$"}}}
