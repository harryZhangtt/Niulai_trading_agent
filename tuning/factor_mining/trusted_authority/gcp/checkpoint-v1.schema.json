{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","kind","epoch","sequence","previous_checkpoint_sha256","manifest_sha256","idempotency_key","storage_request","storage_receipt_sha256","issued_at","key_status_sha256","recovery_transition_sha256","trust_class","signer_key_version","signer_public_key_sha256","signature_encoding","signature"],"properties":{"schema_version":{"const":1},"kind":{"const":"gcp_checkpoint"},"epoch":{"type":"integer","minimum":1},"sequence":{"type":"integer","minimum":1},"previous_checkpoint_sha256":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/sha"}]},"manifest_sha256":{"$ref":"#/$defs/sha"},"idempotency_key":{"$ref":"#/$defs/id"},"storage_request":{"type":"object","additionalProperties":false,"required":["request_id","bucket","object_name","content_sha256","if_generation_match"],"properties":{"request_id":{"$ref":"#/$defs/id"},"bucket":{"$ref":"#/$defs/id"},"object_name":{"type":"string","pattern":"^checkpoints/[0-9]{20}\\.json$"},"content_sha256":{"$ref":"#/$defs/sha"},"if_generation_match":{"const":0}}},"storage_receipt_sha256":{"$ref":"#/$defs/sha"},"issued_at":{"$ref":"#/$defs/time"},"key_status_sha256":{"$ref":"#/$defs/sha"},"recovery_transition_sha256":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/sha"}]},"trust_class":{"enum":["production","synthetic_fixture"]},"signer_key_version":{"$ref":"#/$defs/resource"},"signer_public_key_sha256":{"$ref":"#/$defs/sha"},"signature_encoding":{"enum":["ECDSA_DER_BASE64","FIXTURE_HMAC_SHA256_HEX"]},"signature":{"type":"string","minLength":1,"maxLength":4096}},"$defs":{"sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,62}$"},"time":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},"resource":{"type":"string","pattern":"^projects/[a-z][a-z0-9-]{4,28}/locations/[a-z0-9-]+/[A-Za-z0-9_./-]+$"}}}
