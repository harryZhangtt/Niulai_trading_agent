{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","trust_class","kind","key_version","purpose","algorithm","public_key_sha256","status","effective_at","previous_status_sha256","signer_permission_revoked","policy_sha256","signer_key_version","signer_public_key_sha256","signature_encoding","signature"],"properties":{"schema_version":{"const":1},"trust_class":{"enum":["production","synthetic_fixture"]},"kind":{"const":"gcp_kms_key_status"},"key_version":{"type":"string","pattern":"^projects/[a-z][a-z0-9-]{4,28}/locations/[a-z0-9-]+/keyRings/[A-Za-z0-9_.-]+/cryptoKeys/[A-Za-z0-9_.-]+/cryptoKeyVersions/[0-9]+$"},"purpose":{"enum":["checkpoint","evaluation","publication","revocation"]},"algorithm":{"const":"EC_SIGN_P256_SHA256"},"public_key_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"status":{"enum":["active","retired","revoked"]},"effective_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},"previous_status_sha256":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^[a-f0-9]{64}$"}]},"signer_permission_revoked":{"type":"boolean"},"policy_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"signer_key_version":{"type":"string","pattern":"^projects/[a-z][a-z0-9-]{4,28}/locations/[a-z0-9-]+/keyRings/[A-Za-z0-9_.-]+/cryptoKeys/[A-Za-z0-9_.-]+/cryptoKeyVersions/[0-9]+$"},"signer_public_key_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"signature_encoding":{"enum":["ECDSA_DER_BASE64","FIXTURE_HMAC_SHA256_HEX"]},"signature":{"type":"string","minLength":1,"maxLength":4096}}}
