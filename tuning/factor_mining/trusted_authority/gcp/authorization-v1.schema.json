{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","kind","authorization_id","epoch","sequence","checkpoint_sha256","purpose","manifest_sha256","evaluation_receipt_sha256","evaluator_schema_id","evaluator_schema_version","checker_receipt_sha256","checker_schema_id","checker_schema_version","approval_policy_version","approvals","key_status_sha256","issued_at","expires_at","state","trust_class","signer_key_version","signer_public_key_sha256","signature_encoding","signature"],"properties":{"schema_version":{"const":1},"kind":{"const":"gcp_publication_authorization"},"authorization_id":{"$ref":"#/$defs/id"},"epoch":{"type":"integer","minimum":1},"sequence":{"type":"integer","minimum":1},"checkpoint_sha256":{"$ref":"#/$defs/sha"},"purpose":{"enum":["performance_publication","combination_selection","ev_publication","kelly_publication"]},"manifest_sha256":{"$ref":"#/$defs/sha"},"evaluation_receipt_sha256":{"$ref":"#/$defs/sha"},"evaluator_schema_id":{"$ref":"#/$defs/id"},"evaluator_schema_version":{"type":"integer","minimum":1},"checker_receipt_sha256":{"$ref":"#/$defs/sha"},"checker_schema_id":{"$ref":"#/$defs/id"},"checker_schema_version":{"type":"integer","minimum":1},"approval_policy_version":{"$ref":"#/$defs/id"},"approvals":{"type":"array","minItems":2,"maxItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/sha"}},"key_status_sha256":{"$ref":"#/$defs/sha"},"issued_at":{"$ref":"#/$defs/time"},"expires_at":{"$ref":"#/$defs/time"},"state":{"const":"active"},"trust_class":{"enum":["production","synthetic_fixture"]},"signer_key_version":{"$ref":"#/$defs/resource"},"signer_public_key_sha256":{"$ref":"#/$defs/sha"},"signature_encoding":{"enum":["ECDSA_DER_BASE64","FIXTURE_HMAC_SHA256_HEX"]},"signature":{"type":"string","minLength":1,"maxLength":4096}},"$defs":{"sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,62}$"},"time":{"type":"string","p