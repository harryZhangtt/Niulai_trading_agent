{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","kind","approval_id","approver_id","checkpoint_sha256","manifest_sha256","approval_policy_version","issued_at","expires_at","decision","trust_class","signer_key_version","signer_public_key_sha256","signature_encoding","signature"],"properties":{"schema_version":{"const":1},"kind":{"const":"gcp_publication_approval"},"approval_id":{"$ref":"#/$defs/id"},"approver_id":{"$ref":"#/$defs/id"},"checkpoint_sha256":{"$ref":"#/$defs/sha"},"manifest_sha256":{"$ref":"#/$defs/sha"},"approval_policy_version":{"$ref":"#/$defs/id"},"issued_at":{"$ref":"#/$defs/time"},"expires_at":{"$ref":"#/$defs/time"},"decision":{"const":"approved"},"trust_class":{"enum":["production","synthetic_fixture"]},"signer_key_version":{"$ref":"#/$defs/resource"},"signer_public_key_sha256":{"$ref":"#/$defs/sha"},"signature_encoding":{"enum":["ECDSA_DER_BASE64","FIXTURE_HMAC_SHA256_HEX"]},"signature":{"type":"string","minLength":1,"maxLength":4096}},"$defs":{"sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,62}$"},"time":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},"resource":{"type":"string","pattern":"^projects/[a-z][a-z0-9-]{4,28}/locations/[a-z0-9-]+/[A-Za-z0-9_./-]+$"}}}
