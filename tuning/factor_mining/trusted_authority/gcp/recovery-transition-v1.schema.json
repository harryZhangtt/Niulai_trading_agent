{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","trust_class","kind","from_location","to_location","new_epoch","prior_checkpoint_sha256","writer_fenced","chain_verified","merge_heads","key_status_sha256","issued_at","signer_key_version","signer_public_key_sha256","signature_encoding","signature"],"properties":{"schema_version":{"const":1},"trust_class":{"enum":["production","synthetic_fixture"]},"kind":{"const":"gcp_recovery_epoch_transition"},"from_location":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,62}$"},"to_location":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,62}$"},"new_epoch":{"type":"integer","minimum":2},"prior_checkpoint_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"writer_fenced":{"const":true},"chain_verified":{"const":true},"merge_heads":{"const":false},"key_status_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"issued_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},"signer_key_version":{"type":"string","pattern":"^projects/[a-z][a-z0-9-]{4,28}/locations/[a-z0-9-]+/keyRings/[A-Za-z0-9_.-]+/cryptoKeys/[A-Za-z0-9_.-]+/cryptoKeyVersions/[0-9]+$"},"signer_public_key_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"signature_encoding":{"enum":["ECDSA_DER_BASE64","FIXTURE_HMAC_SHA256_HEX"]},"signature":{"type":"string","minLength":1,"maxLength":4096}}}
