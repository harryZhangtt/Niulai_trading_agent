{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["schema_version","kind","trust_class","request_id","adc_principal_sha256","api_method","resource","raw_response_sha256","bucket","object_name","generation","bucket_metageneration","if_generation_match","content_sha256","verified_at","retain_until","minimum_retention_days","versioning_enabled","retention_policy_seconds","retention_policy_locked","deleted"],"properties":{"schema_version":{"const":1},"kind":{"const":"gcs_provider_verified_object"},"trust_class":{"enum":["production","synthetic_fixture"]},"request_id":{"$ref":"#/$defs/id"},"adc_principal_sha256":{"$ref":"#/$defs/sha"},"api_method":{"const":"storage.objects.insert"},"resource":{"type":"string","pattern":"^projects/_/buckets/[a-z][a-z0-9-]{0,62}/objects/checkpoints/[0-9]{20}\\.json$"},"raw_response_sha256":{"$ref":"#/$defs/sha"},"bucket":{"$ref":"#/$defs/id"},"object_name":{"type":"string","pattern":"^checkpoints/[0-9]{20}\\.json$"},"generation":{"type":"integer","minimum":1},"bucket_metageneration":{"type":"integer","minimum":1},"if_generation_match":{"const":0},"content_sha256":{"$ref":"#/$defs/sha"},"verified_at":{"$ref":"#/$defs/time"},"retain_until":{"$ref":"#/$defs/time"},"minimum_retention_days":{"type":"integer","minimum":1},"versioning_enabled":{"const":true},"retention_policy_seconds":{"type":"integer","minimum":86400},"retention_policy_locked":{"const":true},"deleted":{"const":false}},"$defs":{"sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},"id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,62}$"},"time":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}}}
