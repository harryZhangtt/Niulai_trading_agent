{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"synthetic-factor-evaluator-receipt-v1",
  "$defs":{
    "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "sensitivities":{"type":"array","prefixItems":[{"const":"lag-3"},{"const":"cost-10"},{"const":"lag-3-cost-10"},{"const":"lookback-42"},{"const":"lookback-84"},{"const":"credit-only"},{"const":"real-rate-only"},{"const":"exposure-normalized-baseline"}],"items":false,"minItems":8,"maxItems":8},
    "controls":{"type":"array","prefixItems":[{"const":"adverse-conjunction"},{"const":"signal-shift-12m"},{"const":"label-block-permutation"},{"const":"availability-plus-1-session"}],"items":false,"minItems":4,"maxItems":4},
    "triggers":{"type":"array","prefixItems":[{"const":"protected-access-before-seal-count"},{"const":"availability-timestamp-missing-rate"},{"const":"future-or-same-bar-input-count"},{"const":"split-label-overlap-count"},{"const":"purge-embargo-violation-count"},{"const":"row-alignment-mismatch-count"},{"const":"float-roundtrip-decision-flip-count"},{"const":"undeclared-exclusion-count"},{"const":"holdout-reuse-count"},{"const":"unauthorized-variant-count"},{"const":"sensitivity-sign-flip-rate"},{"const":"single-block-positive-contribution-share"},{"const":"placebo-pass-count"}],"items":false,"minItems":13,"maxItems":13}
  },
  "type":"object","additionalProperties":false,
  "required":["schema_version","kind","evaluation_id","request_sha256","authority_binding","runner_receipt_sha256","evaluator_implementation_sha256","registered_sensitivity_ids","registered_control_ids","registered_quarantine_trigger_ids","terminal_status","scientific_verdict","performance_claim","independent_check_status","outcome_accessed","protected_labels_accessed","limitations"],
  "properties":{"schema_version":{"const":1},"kind":{"const":"synthetic_factor_evaluator_receipt"},"evaluation_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_.-]{0,95}$"},"request_sha256":{"$ref":"#/$defs/sha"},"authority_binding":{"$ref":"../../../investment/factor_mining/rdagent_adapter/v2/request-v2.schema.json#/$defs/binding"},"runner_receipt_sha256":{"$ref":"#/$defs/sha"},"evaluator_implementation_sha256":{"$ref":"#/$defs/sha"},"registered_sensitivity_ids":{"$ref":"#/$defs/sensitivities"},"registered_control_ids":{"$ref":"#/$defs/controls"},"registered_quarantine_trigger_ids":{"$ref":"#/$defs/triggers"},"terminal_status":{"const":"synthetic-structural-complete"},"scientific_verdict":{"const":"withheld"},"performance_claim":{"const":"withheld"},"independent_check_status":{"const":"unavailable"},"outcome_accessed":{"const":false},"protected_labels_accessed":{"const":false},"limitations":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"string","minLength":1,"maxLength":500}}}
}
