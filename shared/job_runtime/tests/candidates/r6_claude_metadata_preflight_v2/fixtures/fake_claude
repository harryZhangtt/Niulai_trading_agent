#!/usr/bin/python3
import base64
import json
import os
import pathlib
import sys
import time

scenario = os.environ.get("R6_FAKE_SCENARIO", "ready")
if scenario == "timeout": time.sleep(2)
if scenario == "nonzero":
    sys.stderr.write("synthetic failure\n"); raise SystemExit(7)
if len(sys.argv) >= 4 and sys.argv[1:] == ["auth", "status", "--json"]:
    if scenario == "malformed": sys.stdout.write("{bad-json")
    else:
        sys.stdout.write(json.dumps({"loggedIn":scenario != "not_ready","authMethod":"synthetic-oauth","email":"private-fixture@example.invalid","access_token":"synthetic-secret-must-redact"},separators=(",", ":")))
    raise SystemExit(0)

events=[json.loads(line) for line in base64.b64decode('').decode('utf-8').splitlines()]
terminal=events[-1]
if scenario == 'duplicate_terminal': terminal['result'] += ' Opus 5.5'
elif scenario == 'negated_model': terminal['result'] = 'Opus 5.5 is unavailable\nUsage: /model <name>. Available: sonnet, opus, haiku, fable, best, or a full model ID.'
elif scenario == 'prefix_model': terminal['result'] = 'Current model: `Opus 5.50` (effort: low)\nUsage: /model <name>. Available: sonnet, opus, haiku, fable, best, or a full model ID.'
elif scenario == 'missing_accounting': del terminal['usage']; del terminal['total_cost_usd']
elif scenario == 'prior_usage': events[1]['message']['usage']['input_tokens']=1
for event in events: sys.stdout.write(json.dumps(event,separators=(",", ":"))+"\n")
