{
  "$id": "r6-data-quality-blind-map-block-grant-review-v4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "block_grant_ref": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "const": "0600"
        },
        "path": {
          "const": "chronology/final-block-grant-v4.json"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256",
        "mode"
      ],
      "type": "object"
    },
    "immutable": {
      "const": true
    },
    "independent_reviewer_id": {
      "pattern": "^HGRV-[0-9A-F]{4,16}$",
      "type": "string"
    },
    "review_id": {
      "minLength": 1,
      "type": "string"
    },
    "reviewed_sequence": {
      "const": 2
    },
    "schema": {
      "const": "r6-data-quality-blind-map-block-grant-review-v4"
    },
    "status": {
      "const": "CLEAN"
    },
    "version": {
      "const": 4
    }
  },
  "required": [
    "version",
    "schema",
    "review_id",
    "block_grant_ref",
    "status",
    "independent_reviewer_id",
    "reviewed_sequence",
    "immutable"
  ],
  "type": "object"
}
