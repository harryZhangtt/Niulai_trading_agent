{
  "$id": "r6-data-quality-blind-map-commitment-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "schema": {"const": "r6-data-quality-blind-map-v1"},
    "canonical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_bytes": {"type": "integer", "minimum": 1}
