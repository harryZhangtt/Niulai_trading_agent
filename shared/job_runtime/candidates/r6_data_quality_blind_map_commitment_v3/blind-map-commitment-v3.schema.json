{
  "$id": "r6-data-quality-blind-map-commitment-v3",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "canonical_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "r6-data-quality-blind-map-v3"
    },
    "version": {
      "const": 3
    }
  },
  "required": [
    "version",
    "schema",
    "canonical_digest",
    "canonical_bytes"
  ],
  "type": "object"
}
