{
  "tools": [
    {
      "name": "option_contracts",
      "description": "Daily-updated option contract reference; one bounded page, free-compatible.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "underlying": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
          },
          "expiration": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "side": {
            "type": "string",
            "enum": [
              "call",
              "put"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "strike_min": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "strike_max": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "underlying"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "option_daily_bars",
      "description": "Historical daily option OHLC, up to 31 days within two years. Excludes today; no quote/Greek tools.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contract": {
            "type": "string",
            "pattern": "^O:[A-Z]{1,6}[0-9]{6}[CP][0-9]{8}$"
          },
          "from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "required": [
          "contract",
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    }
  ]
}
