{
  "tools": [
    {
      "name": "option_chain",
      "description": "One bounded page of free indicative option snapshots. Delayed trades and modified quotes, not NBBO.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "underlying": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
          },
          "expiration": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "side": {
            "type": "string",
            "enum": [
              "call",
              "put"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "strike_min": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "strike_max": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "underlying",
          "expiration",
          "side"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "option_snapshots",
      "description": "Free indicative snapshots for up to five explicit OCC contracts; provider Greeks only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contracts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{1,6}[0-9]{6}[CP][0-9]{8}$"
            },
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true
          }
        },
        "required": [
          "contracts"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    }
  ]
}
