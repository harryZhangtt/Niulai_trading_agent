{
  "tools": [
    {
      "name": "option_expirations",
      "description": "Option expiration dates. AAPL demo works without a key; other symbols require a free account key.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "underlying": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "required": [
          "underlying"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "option_chain",
      "description": "Bounded one-expiration, one-side historical chain. Free-compatible mode only; timestamps and null Greeks preserved.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "underlying": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
          },
          "expiration": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "side": {
            "type": "string",
            "enum": [
              "call",
              "put"
            ]
          },
          "strike_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "required": [
          "underlying",
          "expiration",
          "side"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "option_quote",
      "description": "Historical single OCC-contract quote. Free-compatible mode only; never treated as real-time.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "contract": {
            "type": "string",
            "pattern": "^[A-Z]{1,6}[0-9]{6}[CP][0-9]{8}$"
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "required": [
          "contract"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    }
  ]
}
