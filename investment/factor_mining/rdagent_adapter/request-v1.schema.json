{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/factor-mining/rdagent-request-v1.schema.json",
  "title": "RD-Agent one-loop factor request v1",
  "description": "Structural documentation only; contracts.py enforces cross-field limits and engine identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "request_id", "engine", "task", "limits", "credential_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "rdagent_factor_request"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$"},
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["rdagent_revision", "rdagent_tree", "qlib_profile", "qlib_revision", "qlib_tree", "adapter_version"],
      "properties": {
        "rdagent_revision": {"const": "484776c211e4fbbeef03e0ec00d6bbee7362a4f4"},
        "rdagent_tree": {"const": "d4444284fb4554f75f352ecb1f072cedbf4c6421"},
        "qlib_profile": {"const": "qlib-rdagent-compatible"},
        "qlib_revision": {"const": "2fb9380b342556ddb50a4b24e4fe8655d548b2b8"},
        "qlib_tree": {"const": "0f541590a9efecb9bfb5342155be50461ad7d002"},
        "adapter_version": {"const": "rdagent-adapter-v1"}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "hypothesis", "constraints", "base_features_sha256", "expected_factor_ids"],
      "properties": {
        "mode": {"const": "fin-factor-one-loop"},
        "hypothesis": {"type": "string", "minLength": 1, "maxLength": 4000},
        "constraints": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "base_features_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "expected_factor_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,95}$"}}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["timeout_seconds", "stdout_bytes", "artifact_bytes", "max_factors"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "stdout_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "artifact_bytes": {"type": "integer", "minimum": 1024, "maximum": 1073741824},
        "max_factors": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "credential_refs": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^credential-ref-[a-z0-9_.-]{1,80}$"}}
  }
}
