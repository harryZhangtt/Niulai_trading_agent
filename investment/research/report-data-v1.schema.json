{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-data-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "cutoff",
    "section_count",
    "artifacts",
    "sections",
    "source_ledger_ref",
    "evidence_ledger_ref",
    "palette_receipt_ref",
    "render_receipt_ref",
    "prohibited_actions"
  ],
  "properties": {
    "version": {
      "const": "probability-report-data-1"
    },
    "status": {
      "enum": [
        "draft",
        "final"
      ]
    },
    "cutoff": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "section_count": {
      "const": 11
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "required_status",
          "required_validity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{2,127}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "required_status": {
            "enum": [
              "valid",
              "recheck",
              "stale",
              "blocked"
            ]
          },
          "required_validity": {
            "enum": [
              "valid",
              "invalid",
              "stale",
              "blocked"
            ]
          }
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trust_gate",
        "evidence_states",
        "historical_support",
        "calibration",
        "probability_provenance",
        "robust_worlds",
        "leveraged_paths",
        "position_roadmap",
        "loss_budget",
        "shadow_timeline",
        "audit_appendix"
      ],
