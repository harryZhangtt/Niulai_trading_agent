              "minLength": 1
            },
            "visible_gap": {
              "type": "boolean"
            },
            "model_boundaries_ref": {
              "const": "chart_data#/model_boundaries"
            },
            "decomposition_equation": {
              "const": "total_log_return = intercept_log_return + factor_common_log_return + residual_log_return"
            },
            "residual_definition": {
              "const": "Mechanical remainder after the aggregate intercept and supplied factor terms; never fundamentals, causal contribution, alpha, or probability."
            },
            "decompositions": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target",
                  "exact_reset_benchmark",
                  "investable_proxy_identities",
                  "return_basis",
                  "reconciliation",
                  "source_registry_refs"
                ],
                "properties": {
                  "target": {
                    "enum": [
                      "SOXL",
                      "TQQQ"
                    ]
                  },
                  "exact_reset_benchmark": {
                    "enum": [
                      "NYSE Semiconductor Index",
                      "Nasdaq-100"
                    ]
                  },
                  "investable_proxy_identities": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "symbol",
                        "role",
                        "not_exact_for"
                      ],
                      "properties": {
                        "symbol": {
                          "enum": [
                            "SOXX",
                            "SMH",
                            "QQQ"
                          ]
                        },
                        "role": {
                          "enum": [
                            "investable_semiconductor_proxy",
                            "investable_Nasdaq-100_proxy"
                          ]
                        },
                        "not_exact_for": {
                          "type": "array",
                          "minItems": 2,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "maxItems": 2,
                          "uniqueItems": true
                        }
                      }
                    },
                    "maxItems": 2,
                    "uniqueItems": true
                  },
                  "return_basis": {
                    "const": "adjusted_market_price_total_return"
                  },
                  "reconciliation": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "equation",
                      "total_log_return",
                      "intercept_log_return",
                      "factor_common_log_return",
                      "residual_log_return",
                      "recomputed_total_log_return",
                      "reconciliation_error",
                      "absolute_tolerance",
                      "reconciles"
                    ],
                    "properties": {
                      "equation": {
                        "const": "total_log_return = intercept_log_return + factor_common_log_return + residual_log_return"
                      },
                      "total_log_return": {
                        "type": "number"
                      },
                      "intercept_log_return": {
                        "type": "number"
                      },
                      "factor_common_log_return": {
                        "type": "number"
                      },
                      "residual_log_return": {
                        "type": "number"
                      },
                      "recomputed_total_log_return": {
                        "type": "number"
                      },
                      "reconciliation_error": {
                        "type": "number"
                      },
                      "absolute_tolerance": {
                        "const": 1e-14
                      },
                      "reconciles": {
                        "const": true
                      }
                    }
                  },
                  "source_registry_refs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              },
              "maxItems": 2
            }
          }
        },
