    "trust_policies": {
      "additionalProperties": false,
      "properties": {
        "checker": {
          "$ref": "#/$defs/trust_pair"
        },
        "controller": {
          "$ref": "#/$defs/trust_pair"
        },
        "evaluator": {
          "$ref": "#/$defs/trust_pair"
        },
        "executor": {
          "$ref": "#/$defs/trust_pair"
        },
        "publisher": {
          "$ref": "#/$defs/trust_pair"
        }
      },
      "required": [
