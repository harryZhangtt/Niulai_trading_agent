{
  "$defs": {
    "endpoint_policy": {
      "additionalProperties": false,
      "properties": {
        "Statement": {
          "items": {
            "$ref": "#/$defs/resource_statement"
          },
          "minItems": 1,
          "type": "array"
        },
        "Version": {
          "const": "2012-10-17"
        }
      },
      "required": [
        "Version",
        "Statement"
      ],
      "type": "object"
    },
    "iam_policy": {
      "additionalProperties": false,
      "properties": {
        "Statement": {
          "items": {
            "$ref": "#/$defs/iam_statement"
          },
          "minItems": 1,
          "type": "array"
        },
        "Version": {
          "const": "2012-10-17"
        }
      },
      "required": [
        "Version",
        "Statement"
      ],
      "type": "object"
    },
    "iam_statement": {
      "additionalProperties": false,
      "properties": {
        "Action": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "Condition": {
          "type": "object"
        },
        "Effect": {
          "enum": [
            "Allow",
            "Deny"
          ]
        },
        "Resource": {
          "items": {
            "type": [
              "string",
              "null"
            ]
          },
          "minItems": 1,
          "type": "array"
        },
        "Sid": {
          "type": "string"
        }
      },
      "required": [
        "Sid",
        "Effect",
        "Action",
        "Resource",
        "Condition"
      ],
      "type": "object"
    },
    "resource_statement": {
      "additionalProperties": false,
      "properties": {
        "Action": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "Condition": {
          "type": "object"
        },
        "Effect": {
          "const": "Allow"
        },
        "Principal": {
          "additionalProperties": false,
          "properties": {
            "AWS": {
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": "array"
            }
          },
          "required": [
            "AWS"
          ],
          "type": "object"
        },
        "Resource": {
          "items": {
            "type": [
              "string",
              "null"
            ]
          },
          "minItems": 1,
          "type": "array"
        },
        "Sid": {
          "type": "string"
        }
      },
      "required": [
        "Sid",
        "Effect",
        "Principal",
        "Action",
        "Resource",
        "Condition"
      ],
      "type": "object"
    },
    "task_definition": {
      "additionalProperties": false,
      "properties": {
        "active_access": {
          "const": {
            "kms_sign": false,
            "protected_labels": false,
            "provider_proxy": false,
            "publication": false
          }
        },
        "aggregate_only": {
          "type": "boolean"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "container_count": {
          "const": 1
        },
        "ecs_exec": {
          "const": false
        },
        "execution_role_arn": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": "string"
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "launch_type": {
          "const": "FARGATE"
        },
        "linux_capabilities_drop": {
          "const": [
            "ALL"
          ]
        },
        "output_schema_id": {
          "type": "string"
        },
        "platform_version": {
          "const": "1.4.0"
        },
        "privileged": {
          "const": false
        },
        "raw_joined_rows_output": {
          "const": false
        },
        "readonly_root_filesystem": {
          "const": true
        },
        "redaction_policy_id": {
          "const": "factor-no-sensitive-output-v1"
        },
        "sensitive_logging": {
          "const": false
        },
        "stdout_policy": {
          "const": "structured-sanitized-only"
        },
        "task_role_arn": {
          "type": [
            "string",
            "null"
          ]
        },
        "user": {
          "const": "65532:65532"
        }
      },
      "required": [
        "family",
        "launch_type",
        "platform_version",
        "container_count",
        "image",
        "task_role_arn",
        "execution_role_arn",
        "readonly_root_filesystem",
        "user",
        "privileged",
        "ecs_exec",
        "linux_capabilities_drop",
        "command",
        "output_schema_id",
        "redaction_policy_id",
        "stdout_policy",
        "raw_joined_rows_output",
        "sensitive_logging",
        "aggregate_only",
        "active_access"
      ],
      "type": "object"
    },
    "trust_pair": {
      "additionalProperties": false,
      "properties": {
        "execution": {
          "$ref": "#/$defs/trust_policy"
        },
        "task": {
          "$ref": "#/$defs/trust_policy"
        }
      },
      "required": [
        "task",
        "execution"
      ],
      "type": "object"
    },
    "trust_policy": {
      "additionalProperties": false,
      "properties": {
        "Statement": {
          "items": {
            "$ref": "#/$defs/trust_statement"
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "Version": {
          "const": "2012-10-17"
        }
      },
      "required": [
        "Version",
        "Statement"
      ],
      "type": "object"
    },
    "trust_statement": {
      "additionalProperties": false,
      "properties": {
        "Action": {
          "const": [
            "sts:AssumeRole"
          ]
        },
        "Condition": {
          "additionalProperties": false,
          "properties": {
            "ArnLike": {
              "type": "object"
            },
            "StringEquals": {
              "type": "object"
            }
          },
          "required": [
            "StringEquals",
            "ArnLike"
          ],
          "type": "object"
        },
        "Effect": {
          "const": "Allow"
        },
        "Principal": {
          "const": {
            "Service": "ecs-tasks.amazonaws.com"
          }
        },
        "Sid": {
          "const": "EcsTasksOnly"
        }
      },
      "required": [
        "Sid",
        "Effect",
        "Principal",
        "Action",
        "Condition"
      ],
      "type": "object"
    }
  },
  "$id": "factor-aws-fargate-templates-v1",
