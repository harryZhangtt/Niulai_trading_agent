        "image_receipt_sha256": null,
        "label_policy_receipt_sha256": null,
        "network_receipt_sha256": null,
        "production_retention_lock": false,
        "protected_labels": false,
        "publication": false,
        "publication_policy_receipt_sha256": null,
        "runtime_invocation": false
