      "properties": {
        "checker": {
          "$ref": "#/$defs/iam_policy"
        },
        "controller": {
          "$ref": "#/$defs/iam_policy"
        },
        "evaluator": {
          "$ref": "#/$defs/iam_policy"
        },
        "executor": {
          "$ref": "#/$defs/iam_policy"
        },
        "publisher": {
          "$ref": "#/$defs/iam_policy"
        }
      },
      "required": [
