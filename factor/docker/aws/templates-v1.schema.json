        },
        "ecr_dkr": {
          "$ref": "#/$defs/endpoint_policy"
        },
        "kms": {
          "$ref": "#/$defs/endpoint_policy"
        },
        "logs": {
          "$ref": "#/$defs/endpoint_policy"
        },
        "provider_proxy": {
          "$ref": "#/$defs/endpoint_policy"
        },
        "s3": {
