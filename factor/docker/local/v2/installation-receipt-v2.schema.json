          "output": "limactl version 2.2.1",
          "purpose": "dependency-version-only"
        },
        {
          "command": "shasum -a 256 <five recorded executable paths>",
          "output": "per-tool sha256 fields",
          "purpose": "file-hash"
        },
        {
          "command": "brew services list | select exact colima row",
          "output": "colima none",
          "purpose": "service-state-read-only"
        },
        {
          "command": "ps -axo pid=,comm= | exact-basename filter over process_names_checked",
          "output": "none",
          "purpose": "process-absence-read-only"
        },
        {
          "command": "aggregate ~/.docker tree state before and after version/hash probes",
          "output": "absent before; absent after; contents_and_metadata_unchanged=true",
          "purpose": "no-global-config-mutation"
        }
