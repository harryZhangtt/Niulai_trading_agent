{
  "schema_version": 1,
  "kind": "factor_local_colima_activation_command",
  "status": "selected-disabled",
  "apply_allowed": false,
  "environment": {
    "COLIMA_HOME": "$WORKSPACE/.c",
    "COLIMA_PROFILE": "factor-mining",
    "DOCKER_CONFIG": "$WORKSPACE/factor/runtime/local/docker-config"
  },
  "argv": [
    "/opt/homebrew/bin/colima",
    "start",
    "factor-mining",
    "--activate=false",
    "--runtime",
    "docker",
    "--vm-type",
    "vz",
    "--cpus",
    "6",
    "--memory",
    "12",
    "--disk",
    "40",
    "--root-disk",
    "20",
    "--mount",
    "none",
    "--ssh-config=false",
    "--kubernetes=false",
    "--save-config=true"
  ],
  "rollback_argv": [
    "/opt/homebrew/bin/colima",
    "delete",
    "factor-mining",
    "--force"
  ],
  "preconditions": [
    "workspace-exact",
    "state-root-absent",
    "state-root-not-symlink",
    "socket-path-under-104",
    "global-docker-context-preserved"
  ],
  "executed": false
}
