{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"total-return-receipt-v1","type":"object","additionalProperties":false,
  "required":["schema_version","kind","request_sha256","corporate_action_receipt_sha256","unadjusted_close_commitment_sha256","action_values_commitment_sha256","output_commitment_sha256","output_rows","formula_version","values_included","performance_claim"],
